		"@types/eslint": "^9.6.1",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.5",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.41.2",
		"svelte-check": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^7.1.11"
	},
	"type": "module",
	"dependencies": {
		"@cloudflare/workerd-linux-64": "^1.20251023.0",
